---
/**
 * Decorative cow spots. Deterministic: the same seed always renders the same spots,
 * so builds are stable. Color comes from --color-spot (ink in light, milk in dark).
 */
interface Props {
  seed?: number;
  count?: number;
  /** viewBox width/height — controls the aspect of the spot field */
  width?: number;
  height?: number;
  /** size range of spots as a fraction of the shorter side */
  minSize?: number;
  maxSize?: number;
  class?: string;
}

const {
  seed = 1,
  count = 6,
  width = 1200,
  height = 600,
  minSize = 0.08,
  maxSize = 0.22,
  class: className,
} = Astro.props;

function mulberry32(a: number) {
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

/** Smooth closed path through points (Catmull-Rom converted to cubic Béziers). */
function blobPath(points: [number, number][]) {
  const n = points.length;
  const f = (v: number) => v.toFixed(1);
  let d = `M${f(points[0][0])},${f(points[0][1])}`;
  for (let i = 0; i < n; i++) {
    const p0 = points[(i - 1 + n) % n];
    const p1 = points[i];
    const p2 = points[(i + 1) % n];
    const p3 = points[(i + 2) % n];
    const c1x = p1[0] + (p2[0] - p0[0]) / 6;
    const c1y = p1[1] + (p2[1] - p0[1]) / 6;
    const c2x = p2[0] - (p3[0] - p1[0]) / 6;
    const c2y = p2[1] - (p3[1] - p1[1]) / 6;
    d += ` C${f(c1x)},${f(c1y)} ${f(c2x)},${f(c2y)} ${f(p2[0])},${f(p2[1])}`;
  }
  return d + 'Z';
}

const rand = mulberry32(seed * 9973);
const short = Math.min(width, height);
// Spread spots over a jittered grid so they don't clump into one mass.
const cols = Math.max(1, Math.round(Math.sqrt((count * width) / height)));
const rows = Math.max(1, Math.ceil(count / cols));
const cells = Array.from({ length: cols * rows }, (_, i) => i);
for (let i = cells.length - 1; i > 0; i--) {
  const j = Math.floor(rand() * (i + 1));
  [cells[i], cells[j]] = [cells[j], cells[i]];
}
const paths: string[] = [];
for (let s = 0; s < count; s++) {
  const cell = cells[s % cells.length];
  const cw = width / cols;
  const ch = height / rows;
  const cx = (cell % cols) * cw + cw * (0.2 + rand() * 0.6);
  const cy = Math.floor(cell / cols) * ch + ch * (0.2 + rand() * 0.6);
  const r = short * (minSize + rand() * (maxSize - minSize));
  const stretch = 0.75 + rand() * 0.5;
  const rot = rand() * Math.PI;
  const pts = 7 + Math.floor(rand() * 3);
  const points: [number, number][] = [];
  for (let i = 0; i < pts; i++) {
    const a = (i / pts) * Math.PI * 2;
    const rr = r * (0.7 + rand() * 0.35);
    const x = Math.cos(a) * rr * stretch;
    const y = Math.sin(a) * rr;
    points.push([
      cx + x * Math.cos(rot) - y * Math.sin(rot),
      cy + x * Math.sin(rot) + y * Math.cos(rot),
    ]);
  }
  paths.push(blobPath(points));
}
---

<svg
  class:list={['spots', className]}
  viewBox={`0 0 ${width} ${height}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  {paths.map((d) => (
    <path d={d} />
  ))}
</svg>

<style>
  .spots {
    fill: var(--color-spot);
    pointer-events: none;
  }
</style>
