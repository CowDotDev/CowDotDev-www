---
// Hidden until JS runs; without JS the site simply follows the system theme.
---

<button class="theme-toggle" type="button" aria-label="Toggle dark mode" hidden>
  <svg class="icon moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
  </svg>
  <svg class="icon sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
  if (button) {
    button.hidden = false;
    const root = document.documentElement;
    const sync = () => {
      const dark = root.dataset.theme === 'dark';
      button.setAttribute('aria-pressed', String(dark));
    };
    sync();
    button.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* storage unavailable — theme still applies for this page view */
      }
      sync();
    });
    // Follow system changes when the user hasn't chosen explicitly.
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
      let stored: string | null = null;
      try {
        stored = localStorage.getItem('theme');
      } catch {}
      if (!stored) {
        root.dataset.theme = e.matches ? 'dark' : 'light';
        sync();
      }
    });
  }
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: var(--border-width) solid var(--color-fg);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-fg);
    cursor: pointer;
    transition:
      transform var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out);
  }
  .theme-toggle[hidden] {
    display: none;
  }
  .theme-toggle:hover {
    background: var(--color-pink-soft);
    transform: rotate(-12deg);
  }
  .icon {
    grid-area: 1 / 1;
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .sun {
    display: block;
  }
  :global(:root[data-theme='dark']) .moon {
    display: none;
  }
</style>
