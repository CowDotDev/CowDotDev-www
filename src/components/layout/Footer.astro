---
import Spots from '../brand/Spots.astro';
import { site } from '../../lib/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <Spots
    class="footer-spots"
    seed={42}
    count={9}
    width={1600}
    height={160}
    minSize={0.25}
    maxSize={0.7}
  />
  <div class="container inner">
    <p>
      © {year} {site.author}. Made with care (and a little moo).
    </p>
    <ul aria-label="Elsewhere">
      {site.social.map((s) => (
        <li>
          <a href={s.href} rel={s.href.startsWith('http') ? 'me noopener' : undefined}>
            {s.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-24);
  }
  :global(.footer-spots) {
    width: 100%;
    height: 48px;
    opacity: 0.9;
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-8);
    color: var(--color-fg-muted);
    font-size: var(--text-sm);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
  }
  a {
    color: var(--color-fg);
  }
  a:hover {
    color: var(--color-accent);
  }
</style>
