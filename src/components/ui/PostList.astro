---
import Tag from './Tag.astro';
import { formatDate, tagSlug, type Post } from '../../lib/posts';

interface Props {
  posts: Post[];
  headingLevel?: 'h2' | 'h3';
}
const { posts, headingLevel: H = 'h2' } = Astro.props;
---

{posts.length === 0 ? (
  <p class="empty">Nothing here yet — the cows are still grazing. Check back soon.</p>
) : (
  <ol class="posts">
    {posts.map((post) => (
      <li class="post">
        <time class="eyebrow" datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        <div class="main">
          <H class="title">
            <a href={`/blog/${post.id}`}>{post.data.title}</a>
            {post.data.draft && <span class="draft">draft</span>}
          </H>
          <p class="desc">{post.data.description}</p>
          {post.data.tags.length > 0 && (
            <div class="tags">
              {post.data.tags.map((t) => (
                <Tag tag={t} href={`/tags/${tagSlug(t)}`} />
              ))}
            </div>
          )}
        </div>
      </li>
    ))}
  </ol>
)}

<style>
  .posts {
    list-style: none;
    padding: 0;
    display: grid;
  }
  .post {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
  }
  .post:last-child {
    border-bottom: 1px solid var(--color-border);
  }
  time {
    padding-top: 0.35em;
  }
  .title {
    font-size: var(--text-xl);
  }
  .title a {
    color: var(--color-fg);
    text-decoration: none;
    background-image: linear-gradient(var(--color-accent), var(--color-accent));
    background-size: 0% 2px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size var(--duration-base) var(--ease-out);
  }
  .title a:hover {
    background-size: 100% 2px;
  }
  .desc {
    margin-top: var(--space-2);
    color: var(--color-fg-muted);
    max-width: var(--measure);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .draft {
    margin-left: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    padding: 0.1em 0.5em;
    border-radius: var(--radius-sm);
    background: var(--color-warning);
    color: var(--ink);
    vertical-align: middle;
  }
  .empty {
    color: var(--color-fg-muted);
  }
  @media (max-width: 40rem) {
    .post {
      grid-template-columns: 1fr;
    }
  }
</style>
