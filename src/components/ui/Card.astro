---
interface Props {
  href?: string;
  eyebrow?: string;
  title: string;
  headingLevel?: 'h2' | 'h3';
}
const { href, eyebrow, title, headingLevel: H = 'h3' } = Astro.props;
---

<article class:list={['card', { linked: !!href }]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <H class="title">{href ? <a href={href}>{title}</a> : title}</H>
  <div class="body">
    <slot />
  </div>
  <slot name="footer" />
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-fg);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sticker);
    transition:
      transform var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }
  .linked:hover {
    transform: translate(-2px, -2px) rotate(-0.4deg);
    box-shadow: var(--shadow-sticker-hover);
  }
  .title {
    font-size: var(--text-xl);
  }
  .title a {
    color: var(--color-fg);
    text-decoration: none;
  }
  /* Whole card is clickable via the title link */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .linked:hover .title a {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
  }
  .body {
    color: var(--color-fg-muted);
  }
</style>
