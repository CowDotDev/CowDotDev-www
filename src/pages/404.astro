---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Spots from '../components/brand/Spots.astro';
---

<BaseLayout title="Not found" noindex>
  <section class="container nf">
    <div class="hide" aria-hidden="true">
      <Spots seed={404} count={4} width={200} height={200} minSize={0.16} maxSize={0.26} />
    </div>
    <p class="eyebrow">404</p>
    <h1>This page has wandered off the pasture.</h1>
    <p class="lede">The link may be old, or the cows moved it. Let's get you home.</p>
    <Button href="/">Back to the barn</Button>
  </section>
</BaseLayout>

<style>
  .nf {
    max-width: 40rem;
    padding-block: var(--space-24);
    display: grid;
    justify-items: start;
    gap: var(--space-4);
  }
  .hide {
    width: 6rem;
    aspect-ratio: 1;
    overflow: hidden;
    border: var(--border-width) solid var(--color-fg);
    border-radius: var(--radius-blob);
    background: var(--color-surface);
    box-shadow: var(--shadow-sticker);
  }
  .hide :global(svg) {
    width: 100%;
    height: 100%;
  }
  h1 {
    font-size: var(--text-3xl);
    font-weight: 800;
  }
  .lede {
    color: var(--color-fg-muted);
    margin-bottom: var(--space-4);
  }
</style>
